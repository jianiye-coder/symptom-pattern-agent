# Copy to .env (which is git-ignored). Default mode is the offline mock; no key needed.
SPA_LLM_MODE=mock            # mock | openai
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, vLLM, Ollama...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional, used only to report eval cost (USD per 1M tokens)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
# SQLite path (default: ./data/spa.db)
# SPA_DB_PATH=./data/spa.db
